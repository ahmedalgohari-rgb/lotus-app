{
  "expo": {
    "name": "Lotus",
    "slug": "lotus-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lotus",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lotus.plantcare",
      "buildNumber": "58",
      "icon": "./assets/icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleIconName": "AppIcon",
        "NSCameraUsageDescription": "Lotus needs access to your camera to identify plants and take photos of your plant collection.",
        "NSPhotoLibraryUsageDescription": "Lotus needs access to your photo library to save and retrieve photos of your plants.",
        "NSPhotoLibraryAddUsageDescription": "Lotus needs permission to save plant photos to your photo library."
      },
      "usesAppleSignIn": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D4C5B0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.lotus.plantcare"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAppIcon",
      "./plugins/withWeatherKit",
      "./plugins/withFmtFix",
      "./plugins/withDisableSandbox",
      "expo-font",
      "expo-web-browser",
      "expo-localization",
      "expo-sensors",
      [
        "expo-camera",
        {
          "cameraPermission": "Lotus needs access to your camera to identify plants and take photos of your plant collection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Lotus needs access to your photo library to save and retrieve photos of your plants."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2D5F3F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cd097998-0535-4921-91cf-d0f5abd4a3e2"
      }
    },
    "owner": "ahmedalgohari",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/cd097998-0535-4921-91cf-d0f5abd4a3e2"
    }
  }
}