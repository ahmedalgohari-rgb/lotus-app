{
  "expo": {
    "name": "Lotus Plant Care",
    "slug": "lotus-plant-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lotus",
    "userInterfaceStyle": "automatic",
    "description": "Your personal plant care companion with AI-powered identification and care recommendations.",
    "primaryColor": "#2D5F3F",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lotus.plantcare",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Lotus needs camera access to identify your plants",
        "NSPhotoLibraryUsageDescription": "Lotus needs photo library access to select plant images for identification",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.lotus.plantcare",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#2D5F3F"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lotus to access your camera to identify plants."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lotus to access your photo library to select plant images."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F3E9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fbb1591a-741d-4d38-9a5d-6cd3b16a9193"
      },
      "router": {}
    },
    "owner": "ahmedalgohari"
  }
}
