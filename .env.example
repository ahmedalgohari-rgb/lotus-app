# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Note: The anon key is meant to be public and safe to expose in mobile apps
# Never use the service_role key in React Native - it should only be used on secure backend servers

# 🔒 SECURITY: API Keys Configuration
# PlantNet, OpenWeather, and Perenual keys are stored SECURELY in Supabase Edge Function secrets
# DO NOT add EXPO_PUBLIC_* versions of these keys here - they would be exposed in the app bundle!
#
# Set them as Supabase secrets using CLI:
# 1. supabase secrets set PLANTNET_API_KEY=your_key
# 2. supabase secrets set OPENWEATHER_API_KEY=your_key
# 3. supabase secrets set PERENUAL_API_KEY=your_key  (NEW - for automatic plant research)
#
# See SECURITY_DEPLOYMENT.md and AUTOMATIC_RESEARCH_SETUP.md for full instructions

# Development Configuration
NODE_ENV=development

# 🌱 Plant Identification Provider (MODULAR ARCHITECTURE)
# Choose which AI provider to use for plant identification
# This allows instant switching without code changes (vendor independence)
#
# Available providers:
#   - 'plantnet' (default) - PlantNet API (free, non-commercial, 10 req/hour)
#   - 'plantid' - Plant.id API (commercial-friendly, 1000 free/mo, then $0.05/req)
#   - 'google' - Google Cloud Vision (general-purpose, 1000 free/mo, then $1.50/1000)
#
# BUSINESS CONTEXT:
# PlantNet is non-commercial and may terminate service for commercial apps.
# Use Plant.id or Google Vision as backup if PlantNet becomes unavailable.
#
# To switch providers:
# 1. Change value below (e.g., EXPO_PUBLIC_PLANT_ID_PROVIDER=plantid)
# 2. Rebuild app: npx expo prebuild
# 3. Restart: npx expo start --clear
#
EXPO_PUBLIC_PLANT_ID_PROVIDER=plantnet

# 🤖 Automatic Plant Research System (NEW)
# Perenual API is used to automatically research plants not in our database
# Free tier: 300 requests/day (sufficient for auto-research with caching)
# Get your free API key: https://perenual.com/docs/api
#
# This is stored as Supabase secret (not exposed in app):
#   supabase secrets set PERENUAL_API_KEY=your_key_here
#
# See AUTOMATIC_RESEARCH_SETUP.md for setup instructions

# GitHub Repository
GITHUB_REPO=https://github.com/ahmedalgohari-rgb/lotus-app
GITHUB_USER=ahmedalgohari-rgb
