# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url_here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Note: The anon key is meant to be public and safe to expose in mobile apps
# Never use the service_role key in React Native - it should only be used on secure backend servers

# PlantNet API Configuration
EXPO_PUBLIC_PLANTNET_API_KEY=your_plantnet_api_key_here

# OpenWeather API Configuration (Cairo weather)
# Get your free API key from: https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Development Configuration
NODE_ENV=development

# GitHub Repository
GITHUB_REPO=https://github.com/ahmedalgohari-rgb/lotus-app
GITHUB_USER=ahmedalgohari-rgb
