# Lotus Plant Care App - Environment Variables Template
#
# IMPORTANT: This is a template file with placeholder values.
# Copy this file to .env and replace with your actual API keys.
#
# ⚠️ SECURITY WARNING:
# - NEVER commit your .env file with real API keys to git
# - NEVER share your .env file or API keys publicly
# - Keep your API keys secret and rotate them regularly
#

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
#
# Instructions:
# 1. Create a free Supabase account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings > API to find your project URL and anon key
# 4. Run the SQL migrations in supabase/migrations/ folder

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here


# ============================================================================
# PlantNet API Configuration
# ============================================================================
# Get your API key from: https://my.plantnet.org/
#
# Instructions:
# 1. Create a free account at https://my.plantnet.org/
# 2. Request an API key (free tier: 500 requests/day)
# 3. Add your IP address to the API key authorization list
# 4. Copy the API key below

EXPO_PUBLIC_PLANTNET_API_KEY=your-plantnet-api-key-here


# ============================================================================
# OpenWeather API Configuration
# ============================================================================
# Get your API key from: https://openweathermap.org/api
#
# Instructions:
# 1. Create a free account at https://openweathermap.org/
# 2. Generate an API key (free tier: 1000 requests/day)
# 3. Copy the API key below
# 4. Note: It may take a few minutes for the key to activate

EXPO_PUBLIC_OPENWEATHER_API_KEY=your-openweather-api-key-here


# ============================================================================
# Optional: Development & Testing Configuration
# ============================================================================

# Enable PlantNet API debug logging (true/false)
# EXPO_PUBLIC_DEBUG_PLANTNET=false

# Use staging Supabase project for development
# EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key


# ============================================================================
# Security Best Practices
# ============================================================================
#
# 1. API Key Rotation:
#    - Rotate your API keys every 90 days
#    - Immediately rotate if you suspect a key has been compromised
#
# 2. API Key Restrictions:
#    - PlantNet: Add IP restrictions in your dashboard
#    - OpenWeather: Add domain restrictions if deploying to web
#    - Supabase: Use Row-Level Security (RLS) policies
#
# 3. Monitoring:
#    - Monitor your API usage regularly
#    - Set up billing alerts to catch unauthorized usage
#    - Review API logs for suspicious activity
#
# 4. Development vs Production:
#    - Use separate API keys for development and production
#    - Use .env.local for local development overrides
#    - Never use production keys in development
#
# 5. Version Control:
#    - Ensure .env is in .gitignore (already configured)
#    - Use .env.example for sharing configuration templates
#    - Use environment variables in CI/CD pipelines
#
# ============================================================================
